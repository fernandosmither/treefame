---
const currentPath = Astro.url.pathname;
---

<nav class="sticky top-0 z-50 border-b border-white/[0.06] bg-surface-0/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img src="/logo.svg" alt="TreeFame" class="h-9 w-9 transition-transform group-hover:scale-105" />
        <span class="font-display font-bold text-lg tracking-tight">
          <span class="text-gold-400">Tree</span><span class="text-zinc-200">Fame</span>
        </span>
      </a>

      <!-- Nav links -->
      <div class="flex items-center gap-1">
        <a
          href="/"
          class:list={[
            "px-3 py-1.5 rounded-md text-sm font-medium transition-colors",
            currentPath === "/" || currentPath === "" ? "text-gold-400 bg-gold-400/10" : "text-zinc-400 hover:text-zinc-200 hover:bg-white/[0.04]"
          ]}
        >
          Leaderboard
        </a>
        <a
          href="https://treefail.fdosmith.dev"
          class="px-3 py-1.5 rounded-md text-sm font-medium text-zinc-500 hover:text-red-400 hover:bg-red-400/5 transition-colors"
          target="_blank"
        >
          TreeFail
        </a>
      </div>
    </div>
  </div>
</nav>
